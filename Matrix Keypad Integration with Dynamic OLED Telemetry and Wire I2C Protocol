#include <Adafruit_SSD1306.h>
#include <Keypad.h>
#include <Wire.h>

#define SW 128
#define SH 64 
Adafruit_SSD1306 display(SW, SH, &Wire, -1);

const byte ROWS = 4;
const byte COLS = 4;

char hexaKeys [ROWS] [COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {25,26,32,33};
byte colPins[COLS] = {12,13,14,27};

Keypad customKeypad = Keypad(makeKeymap(hexaKeys), rowPins, colPins, ROWS, COLS);

void setup() {
  Serial.begin(115200);
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Oled Error");
    while(1);
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.print("Enter the code BRUH:");
  display.display();
}

void loop() {
  char customKey = customKeypad.getKey();
  if(customKey == '1') {
    display.clearDisplay();
    display.setCursor(0, 0);
    display.print("LED SHOW TWIN! You ARE a LEGEND fr");
    display.display();
  }
  if(customKey == '5') {
    display.clearDisplay();
    display.setCursor(0, 0);
    display.print("SERVO 90 - 2 of them... I guess bro...");
    display.display(); 
  }
  if(customKey == '9') {
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("Jarvis, is the System okay?");
    display.display();
    delay(2500);
    display.println("Fuh nah sir...");
    display.display();
  }
  if(customKey == 'A') {
    display.clearDisplay();
    display.setCursor(0, 0);
    display.print("I am done bro, sir --- You DO what YOU want...ninja");
    delay(1500);
    display.clearDisplay();
    display.display();
  }
  delay(15);
}
