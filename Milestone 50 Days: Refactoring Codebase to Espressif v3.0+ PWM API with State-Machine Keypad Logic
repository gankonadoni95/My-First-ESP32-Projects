#include <Keypad.h>

byte green_led = 17;
const byte ROWS = 4;
const byte COLS = 4;

char hexaKeys [ROWS] [COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {25, 26, 32, 33};
byte colPins[COLS] = {12, 13, 14, 27};

Keypad customKeypad = Keypad(makeKeymap(hexaKeys), rowPins, colPins, ROWS, COLS);

void setup() {
  Serial.begin(115200);
  pinMode(17, OUTPUT);
  ledcAttach(17, 5000, 8);
}

enum class SystemMode {
  ENTER_CODE,
  LEDALARM
};

SystemMode currState = SystemMode::ENTER_CODE;

void loop() {
  char customKey = customKeypad.getKey();
  switch(currState) {
    case SystemMode::ENTER_CODE:
    if(customKey == '5') {
      ledcWrite(17, 0);
      currState = SystemMode::LEDALARM;
    }
    break;

    case SystemMode::LEDALARM:
    if(customKey == '9') {
      for(int i = 0; i <= 255; i++) {
        ledcWrite(17, i);
        delay(15);
      }
      delay(1000);

      for(int i = 255; i >= 0; i--) {
        ledcWrite(17, i);
        delay(15);
      }
      currState = SystemMode::ENTER_CODE;
    }
  }
}
